# ==============================================================================
# JR FinCloud — Variáveis de Ambiente do Backend (EXEMPLO)
# Copie para backend/.env em desenvolvimento ou configure no Railway / Vercel
# ==============================================================================

# Ambiente: development | staging | production | test
ENV=development
PROJECT_NAME="JR FinCloud - Plataforma de Gestão Financeira"
COMPANY_DISPLAY_NAME="JR FinCloud"
APP_PUBLIC_URL=https://app.jrfincloud.com.br

# Segurança JWT (OBRIGATÓRIO >= 32 caracteres em production; gere com: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=substitua-por-uma-chave-secreta-aleatoria-com-no-minimo-64-caracteres
COOKIE_SECURE=false

# CORS (origens permitidas separadas por vírgula; ex.: URL oficial da Vercel)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://seu-app.vercel.app

# Banco de Dados Onda 1 — PostgreSQL 16 no Supabase (Região South America / sa-east-1 São Paulo)
# No Supabase: Settings -> Database -> Connection string (Session Pooler IPv4 / porta 5432 ou Direct)
# Formato: postgresql+psycopg://postgres.<project_ref>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.projectref:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Banco Legado / Onda 0 (SQLite local ou Turso LibSQL — manter vazio ao usar apenas Supabase v2)
DATABASE_PATH=./database/bimer.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Bootstrap inicial de administrador Onda 0 (opcional, apenas se tabela usuarios estiver vazia)
ADMIN_INITIAL_EMAIL=admin@suaempresa.com.br
ADMIN_INITIAL_PASSWORD=

# Parâmetros CNAB 240 opcionais (na v2 são lidos por empresa/conta no banco de dados)
EMPRESA_CNPJ=
EMPRESA_RAZAO_SOCIAL=
EMPRESA_CIDADE=SALVADOR
EMPRESA_CEP=40000000
EMPRESA_UF=BA
ITAU_AGENCIA=
ITAU_CONTA=
ITAU_DAC=

# Integração WhatsApp Cloud / Evolution API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_DEFAULT_NUMBER=

# Object Storage Privado (S3-compatible)
# Opção A — Supabase Storage S3 (Storage -> S3 Access Keys):
#   STORAGE_ENDPOINT_URL=https://<project_ref>.supabase.co/storage/v1/s3
#   STORAGE_REGION=sa-east-1
# Opção B — Cloudflare R2 (egresso R$ 0):
#   STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=https://<project_ref>.supabase.co/storage/v1/s3
STORAGE_BUCKET=jr-fincloud-docs
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=sa-east-1
